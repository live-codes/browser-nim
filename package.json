{
  "name": "browser-nim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Proof of concept: compile and run Nim in the browser, no server, reusing the LiveCodes Clang 22 toolchain",
  "scripts": {
    "assets:nim": "node scripts/fetch-nim-assets.mjs",
    "assets:clang": "clang-wasm-copy-assets vendor/clang",
    "bundle": "esbuild vendor-entry.js --bundle --format=esm --outfile=vendor/nim-playground.js && esbuild src/nim-worker.js --bundle --format=iife --outfile=vendor/nim-worker.js",
    "setup": "npm run assets:nim && npm run assets:clang && npm run bundle",
    "start": "node serve.mjs",
    "measure:size": "node scripts/measure-wasm-size.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@live-codes/clang-wasm": "^0.2.0",
    "@live-codes/nim-wasm": "file:./packages/nim-wasm",
    "esbuild": "^0.25.0"
  }
}
