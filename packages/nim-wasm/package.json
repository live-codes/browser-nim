{
  "name": "@live-codes/nim-wasm",
  "version": "0.4.0",
  "description": "Run Nim by either backend, on the Nim compiler compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "node": "./src/index.node.js",
      "browser": "./src/index.js",
      "default": "./src/index.js"
    },
    "./frame": {
      "node": "./src/js-runtime.node.js",
      "browser": "./src/js-runtime.js",
      "default": "./src/js-runtime.js"
    },
    "./iife": "./dist/nim-wasm.global.js"
  },
  "bin": {
    "nim-wasm-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "dist",
    "docs",
    "assets",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:iife": "node scripts/build-iife.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@live-codes/clang-wasm": "^0.3.0"
  },
  "keywords": [
    "nim",
    "wasm",
    "webassembly",
    "compiler",
    "playground"
  ]
}
